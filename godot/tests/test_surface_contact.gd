extends SceneTree
var failures:=0
func check(ok:bool,message:String)->void:
	if not ok: failures+=1; push_error(message)
func _initialize()->void:
	var source=load("res://scripts/surface_contact.gd")
	if source==null: push_error("continuous surface contact missing"); quit(1); return
	var model=source.new()
	var p:=PackedVector3Array([Vector3(-1,0,-1),Vector3(1,0,-1),Vector3(0,0,1)])
	var ids:=PackedInt32Array([0,1,2])
	var hit:Dictionary=model.sweep(Vector3(0,1,0),Vector3(0,-1,0),.02,p,ids)
	check(hit.hit and absf(hit.position.y-.02)<.00001,"fast face crossing stops at sphere surface clearance")
	check(hit.normal.is_finite() and absf(hit.normal.length()-1.)<.00001,"contact normal finite and unit")
	hit=model.sweep(Vector3(0,-1,0),Vector3(0,1,0),.02,p,ids)
	check(hit.hit and absf(hit.position.y+.02)<.00001,"surface is two-sided")
	hit=model.sweep(Vector3(0,1,0),Vector3(0,-1,0),.02,p,PackedInt32Array())
	check(not hit.hit,"absent triangle is an actual opening")
	hit=model.sweep(Vector3(0,1,-1.01),Vector3(0,-1,-1.01),.02,p,ids)
	check(hit.hit and hit.position.y>0.,"sphere grazes triangle edge beyond face projection")
	hit=model.sweep(Vector3(0,1,1.01),Vector3(0,-1,1.01),.02,p,ids)
	check(hit.hit,"sphere catches vertex")
	hit=model.sweep(Vector3(3,1,0),Vector3(3,-1,0),.02,p,ids)
	check(not hit.hit,"distant segment has no false contact")
	hit=model.sweep(Vector3(0,.02,0),Vector3(.2,.02,0),.02,p,ids)
	check(not hit.hit,"parallel surface motion does not stick")
	hit=model.sweep(Vector3(0,.01,0),Vector3(0,.2,0),.02,p,ids)
	check(not hit.hit,"initially overlapping tool may withdraw")
	hit=model.sweep(Vector3(NAN,1,0),Vector3.ZERO,.02,p,ids)
	check(not hit.get("valid",true),"nonfinite motion is rejected")
	hit=model.sweep(Vector3(0,1,0),Vector3.ZERO,.02,p,PackedInt32Array([0,1,99]))
	check(not hit.get("valid",true),"invalid topology is rejected")
	var square:=PackedVector3Array([Vector3(-1,0,-1),Vector3(1,0,-1),Vector3(1,0,1),Vector3(-1,0,1)])
	hit=model.sweep(Vector3(-.5,.02,0),Vector3(.5,.02,0),.02,square,PackedInt32Array([0,2,1,0,3,2]))
	check(not hit.hit,"coplanar internal seams cannot catch a tangent tool")
	hit=model.sweep(Vector3(1e20,1,0),Vector3.ZERO,.02,p,ids)
	check(not hit.get("valid",true),"finite overflowing coordinates are rejected")
	print("Surface contact: ",failures," failures"); quit(1 if failures else 0)
