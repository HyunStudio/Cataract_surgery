extends SceneTree
var failures:=0
func check(ok:bool,message:String)->void:
	if not ok: failures+=1; push_error(message)
func _initialize()->void:
	var source=load("res://scripts/capsule_surface.gd")
	if source==null: push_error("capsule geometry kernel missing"); quit(1); return
	var model=source.new()
	var p:=PackedVector3Array([Vector3(-1,0,-1),Vector3(1,0,-1),Vector3(0,0,1)])
	var ids:=PackedInt32Array([0,1,2])
	var r:Dictionary=model.query(Vector3(0,-1,0),Vector3(0,1,0),.02,p,ids)
	check(r.valid and r.hit and r.distance<.000001,"mid shaft intersects face with endpoints clear")
	r=model.query(Vector3(-2,1e-9,0),Vector3(2,-1e-9,0),.02,p,ids)
	check(r.distance<1e-12,"near parallel plane crossing retains actual face intersection")
	for scale in [1.,100.]:
		var skinny:=PackedVector3Array([Vector3.ZERO,Vector3(scale,0,0),Vector3(scale,1e-5,0)])
		var a:=Vector3(.75*scale,2.5e-6,-1); var b:=Vector3(.75*scale,2.5e-6,1)
		r=model.query(a,b,1e-8,skinny,ids)
		check(r.valid and r.hit and r.distance<1e-8,"skinny nonzero face interior cannot be reduced to its edges")
		r=model.sweep(a,b,a,b,1e-8,skinny,ids)
		check(r.valid and r.hit,"stationary sweep retains skinny face contact")
	r=model.query(Vector3(-.2,.03,0),Vector3(.2,.03,0),.02,p,ids)
	check(r.valid and not r.hit and absf(r.distance-.03)<.000001,"parallel segment has exact face clearance")
	r=model.query(Vector3(-.2,.02,0),Vector3(.2,.02,0),.02,p,ids)
	check(r.hit and absf(r.penetration)<.000001,"face grazing counts as contact")
	var near_a:=Vector3(-.2,.02000005,0); var near_b:=Vector3(.2,.02000005,0)
	check(model.query(near_a,near_b,.02,p,ids).hit and model.sweep(near_a,near_b,near_a,near_b,.02,p,ids).hit,"stationary sweep and query share contact tolerance")
	r=model.query(Vector3(-.2,.01,-1.01),Vector3(.2,.01,-1.01),.02,p,ids)
	check(r.hit and absf(r.distance-sqrt(.0002))<.000001,"shaft catches triangle edge")
	r=model.query(Vector3(0,.01,1.01),Vector3(0,.01,1.01),.02,p,ids)
	check(r.hit,"zero length shaft catches vertex")
	var deg:=PackedVector3Array([Vector3(-1,0,0),Vector3(1,0,0),Vector3.ZERO])
	r=model.query(Vector3(0,-1,0),Vector3(0,1,0),.02,deg,ids)
	check(r.hit and r.normal.is_finite(),"degenerate collinear triangle retains segment contact")
	var shallow:=PackedVector3Array([Vector3(-1,-1e-4,0),Vector3(1,1e-4,0),Vector3(-1,-1e-4,0)])
	r=model.query(Vector3(-1,0,0),Vector3(1,0,0),1e-6,shallow,ids)
	check(r.valid and r.hit and r.distance<1e-7,"near parallel edge crossing remains an interior segment pair contact")
	r=model.sweep(Vector3(-1,0,0),Vector3(1,0,0),Vector3(-1,0,0),Vector3(1,0,0),1e-6,shallow,ids)
	check(r.valid and r.hit,"stationary sweep retains shallow crossing edges")
	r=model.query(Vector3.ZERO,Vector3.ONE,.02,p,PackedInt32Array([0,1,2,99,1,2]))
	check(not r.valid and not r.hit,"topology rejection is atomic after early possible hit")
	r=model.query(Vector3.ZERO,Vector3.ONE,.02,p,PackedInt32Array([0,1]))
	check(not r.valid,"incomplete triangle rejected")
	r=model.query(Vector3(NAN,0,0),Vector3.ONE,.02,p,ids)
	check(not r.valid,"NAN shaft rejected")
	r=model.query(Vector3.ZERO,Vector3.ONE,NAN,p,ids)
	check(not r.valid,"NAN radius rejected")
	var bad:=p.duplicate(); bad.append(Vector3(INF,0,0))
	r=model.query(Vector3.ZERO,Vector3.ONE,.02,bad,ids)
	check(not r.valid,"unused invalid point rejected atomically")
	r=model.query(Vector3.ZERO,Vector3.ONE,.02,p,ids,func(_c): return true)
	check(r.valid and r.hit and r.get("conservative",false),"arbitrary ignored overlapping region is uncertified and fails closed")
	r=model.query(Vector3(-.2,.01,0),Vector3(.2,.01,0),.02,p,ids,func(c): return absf(c.axis_point.x)>.05)
	check(r.valid and r.hit and r.get("conservative",false),"ignored endpoints cannot certify clear central shaft interval")
	r=model.sweep(Vector3(-2,1,0),Vector3(2,1,0),Vector3(-2,-1,0),Vector3(2,-1,0),.02,p,ids)
	check(r.valid and r.hit and r.time>.48 and r.time<.491,"fast entire shaft sweep cannot tunnel")
	r=model.sweep(Vector3(0,.01,0),Vector3(.2,.01,0),Vector3(0,.2,0),Vector3(.2,.2,0),.02,p,ids)
	check(r.valid and not r.hit,"initial overlap permits certified outward recovery")
	r=model.sweep(Vector3(-2,1,0),Vector3(2,1,0),Vector3(-2,-1,0),Vector3(2,-1,0),.02,p,ids,func(c): return c.time<.6)
	check(r.valid and r.hit,"ignored early contact cannot hide later intact contact on same triangle")
	r=model.sweep(Vector3(-.2,1,0),Vector3(.2,1,0),Vector3(-.2,.5,0),Vector3(.2,.5,0),.02,p,ids)
	check(r.valid and not r.hit,"certified clear sweep succeeds")
	var repeated:=PackedInt32Array()
	for i in range(8193): repeated.append_array(ids)
	r=model.sweep(Vector3(.9,.01,.9),Vector3(.91,.01,.9),Vector3(.9,.01,.9),Vector3(.91,.01,.9),.02,p,repeated)
	check(r.valid and r.hit and r.conservative and r.reason=="work_budget","work exhaustion fails closed")
	r=model.sweep(Vector3.ZERO,Vector3.ONE,Vector3(NAN,0,0),Vector3.ONE,.02,p,ids)
	check(not r.valid and not r.hit,"invalid final sweep endpoint rejected atomically")
	r=model.query(Vector3(-.2,.01,0),Vector3(.2,.01,0),.02,p,ids,func(c): return c.axis_point.x<0.0)
	check(r.hit and r.axis_point.x>=0.0,"ignored witness cannot hide another intact feature of the same triangle")
	check(p.size()==3 and ids==PackedInt32Array([0,1,2]),"queries never mutate mesh arrays")
	print("Capsule surface: ",failures," failures"); quit(1 if failures else 0)
