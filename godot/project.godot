; OphthoSim — dedicated Godot edition. Engine pinned in docs/GODOT_GAME_KO.md.
config_version=5

[application]
config/name="OphthoSim Surgical Simulator"
run/main_scene="res://simulator.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/description="Specialist cataract simulation game with uncalibrated numerical tissue models"

[display]
window/size/viewport_width=1600
window/size/viewport_height=1000
window/size/window_width_override=1440
window/size/window_height_override=900
window/stretch/mode="canvas_items"
window/size/min_width=1152
window/size/min_height=720

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.022, 0.04, 0.055, 1)

[physics]
common/physics_ticks_per_second=60
